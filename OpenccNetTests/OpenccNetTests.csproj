<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net8.0 selects OpenccNetLib's netstandard2.0 fallback; net10.0 selects its net9.0 asset. -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0"/>
        <PackageReference Include="MSTest" Version="4.4.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenccNetLib\OpenccNetLib.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="滕王阁序.docx">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\OpenccNetLib\data\dictionary_maxlength.cbor"
              Link="data\dictionary_maxlength.cbor"
              CopyToOutputDirectory="PreserveNewest"
              Pack="false"/>

        <None Include="..\OpenccNetLib\data\dictionary_maxlength.json"
              Link="data\dictionary_maxlength.json"
              CopyToOutputDirectory="PreserveNewest"
              Pack="false"/>
    </ItemGroup>

</Project>
