<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net9.0</TargetFrameworks>

        <!-- Package Information for NuGet -->
        <PackageId>OpenccNetLib</PackageId>
        <Version>1.7.0</Version>
        <Authors>laisuk</Authors>
        <Description>
            OpenCC .NET library for Chinese text conversion between Traditional and Simplified Chinese.
            Supports high-performance dictionary-based segment replacement with support for both CLI and GUI tools.
        </Description>
        <PackageTags>opencc;chinese;conversion;traditional;simplified</PackageTags>
        <RepositoryUrl>https://github.com/laisuk/OpenccNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/laisuk/OpenccNet</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- Generate the XML doc file alongside the DLL -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- (Optional) don’t warn about undocumented public members -->
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Title>OpenccNet Library</Title>
        <PackageReleaseNotes>OpenccNetLib v1.7.0

            - Embedded the canonical built-in Zstandard dictionary in OpenccNetLib for lazy filesystem-independent default loading.
            - Added public independent DictionaryLib.FromZstd(string) and DictionaryLib.FromZstdBytes(byte[]) loading APIs.
            - Added Opencc constructors accepting an explicit DictionaryMaxlength through an instance-owned conversion-plan cache.
            - Added constructor-time frozen Opencc instances with immutable configuration and private plan caches based on DictionaryLib.Provider.
            - Added per-instance custom dictionaries with the new Opencc(OpenccConfig, IEnumerable&lt;CustomDictSpec&gt;, bool, bool) constructor.
            - Added Opencc.WithCustomDictionary() for creating a new isolated custom converter while preserving the source configuration and IDS setting.
            - Per-instance custom dictionaries are layered on a snapshot of the currently active global dictionary provider without modifying global state.
            - Custom converter instances remain isolated from later global provider changes and retain their custom dictionary when switching configurations.
            - Ordinary Opencc instances continue using the shared global conversion-plan cache with no private dictionary or plan-cache allocation.
            - Internalized ConversionPlanCache, DictRefs, and StarterUnion as implementation details and simplified conversion-plan/provider ownership.
            - DictionaryLib.Provider remains the public built-in/default dictionary provider.
            - Existing Opencc.UseCustomDictionary() and Opencc.UseDefaultDictionary() retain their process-wide behavior.
            - Internalized compatibility normalization implementation types; use Opencc.NormalizeCompat, Opencc.NormalizeUnicodeCompat, and Opencc.NormalizeCompatExtended.
            - Removed the unreleased NormalizeCompat(string, bool) overload; direct CompatIdeographs and two-argument overload consumers must migrate to the three named facade methods.
            - Updated DeToFu table data.
        </PackageReleaseNotes>
        <AssemblyVersion>1.7.0.0</AssemblyVersion>
        <FileVersion>1.7.0.0</FileVersion>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PeterO.Cbor" Version="4.5.5"/>
        <PackageReference Include="System.Memory" Version="4.6.3"/>
        <PackageReference Include="System.Text.Json" Version="8.0.6"/>
        <PackageReference Include="ZstdSharp.Port" Version="0.8.8"/>
    </ItemGroup>

    <!-- Include icon file in package -->
    <ItemGroup>
        <None Include="Images/icon.png" Pack="true" PackagePath="/"/>
        <None Update="dicts\Unicode_Compatibility.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <!-- Include README in package -->
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <!-- Dictionary files - included in package and copied to output -->
    <ItemGroup>
        <!-- Canonical built-in provider data; the logical name is stable across project renames. -->
        <EmbeddedResource Include="dicts\dictionary_maxlength.zstd"
                          LogicalName="OpenccNetLib.Resources.dictionary_maxlength.zstd" />

        <!-- Include all files under dicts (with extensions) -->
        <None Include="dicts\**\*.*">
            <Pack>true</Pack>
            <PackagePath>contentFiles\any\any\dicts\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="data\**\*.*">
            <Pack>false</Pack>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
