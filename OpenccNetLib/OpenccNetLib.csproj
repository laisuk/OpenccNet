<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net9.0</TargetFrameworks>

        <!-- Package Information for NuGet -->
        <PackageId>OpenccNetLib</PackageId>
        <Version>1.8.0</Version>
        <Authors>laisuk</Authors>
        <Description>
            OpenCC .NET library for Chinese text conversion between Traditional and Simplified Chinese.
            Supports high-performance dictionary-based segment replacement with support for both CLI and GUI tools.
        </Description>
        <PackageTags>opencc;chinese;conversion;traditional;simplified</PackageTags>
        <RepositoryUrl>https://github.com/laisuk/OpenccNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/laisuk/OpenccNet</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- Generate the XML doc file alongside the DLL -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- (Optional) don’t warn about undocumented public members -->
        <!-- <NoWarn>$(NoWarn);1591</NoWarn>-->
        <Title>OpenccNet Library</Title>
        <PackageReleaseNotes>OpenccNetLib v1.8.0
            - Added Small Seal Script conversion support with four new configurations: s2seal, t2seal, seal2s, and seal2t.
            - Added direct Opencc.S2Seal(), Opencc.T2Seal(), Opencc.Seal2S(), and Opencc.Seal2T() conversion APIs.
            - Added SealCharacters, SealCharactersRev, SealVariants, and SealVariantsRev dictionary slots, including support for the existing custom-dictionary append/override workflows.
            - Integrated Small Seal Script conversions with the existing cached multi-round conversion-plan architecture and optional punctuation conversion.
            - Updated built-in OpenCC conversion dictionary data and Unicode Compatibility mappings.
            - Slimmed JSON, Zstd-JSON, and CBOR dictionary artifacts by omitting derived starter metadata from eligible slots with LengthMask 1..3 and no LongLengths.
            - Rebuilds omitted starter metadata once during dictionary loading while preserving the existing runtime conversion paths and UTF-16 code-unit length semantics.
            - Preserved longer-phrase metadata and existing legacy null/empty metadata repair behavior.
            - New dictionary readers remain compatible with existing artifacts; older readers are not guaranteed to accept newly generated slim artifacts.
            - Regenerated the built-in JSON, CBOR, and Zstandard dictionary artifacts with the updated conversion data and Small Seal Script dictionaries.
        </PackageReleaseNotes>
        <AssemblyVersion>1.8.0.0</AssemblyVersion>
        <FileVersion>1.8.0.0</FileVersion>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <LangVersion>9.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Formats.Cbor" Version="8.0.0"/>
        <PackageReference Include="System.Memory" Version="4.6.3"/>
        <PackageReference Include="System.Text.Json" Version="8.0.6"/>
        <PackageReference Include="ZstdSharp.Port" Version="0.8.8"/>
    </ItemGroup>

    <!-- Include icon file in package -->
    <ItemGroup>
        <None Include="Images/icon.png" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <!-- Include README in package -->
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <!-- Dictionary files - included in package and copied to output -->
    <ItemGroup>
        <!-- Canonical built-in provider data; the logical name is stable across project renames. -->
        <EmbeddedResource Include="dicts\dictionary_maxlength.zstd"
                          LogicalName="OpenccNetLib.Resources.dictionary_maxlength.zstd"/>

        <!-- Built-in Unicode compatibility normalization tables. -->
        <EmbeddedResource Include="dicts\CJK_Compatibility_Ideographs.txt"
                          LogicalName="OpenccNetLib.Resources.CJK_Compatibility_Ideographs.txt"/>

        <EmbeddedResource Include="dicts\Unicode_Compatibility.txt"
                          LogicalName="OpenccNetLib.Resources.Unicode_Compatibility.txt"/>

        <!-- Built-in DeTofu fallback table. -->
        <EmbeddedResource Include="dicts\CharactersTofu.txt"
                          LogicalName="OpenccNetLib.Resources.CharactersTofu.txt"/>

        <!-- Include all files under dicts (with extensions) -->
        <None Include="dicts\**\*.*"
              Exclude="
        dicts\dictionary_maxlength.zstd;
        dicts\CJK_Compatibility_Ideographs.txt;
        dicts\Unicode_Compatibility.txt;
        dicts\CharactersTofu.txt">
            <Pack>true</Pack>
            <PackagePath>contentFiles\any\any\dicts\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="data\**\*.*">
            <Pack>false</Pack>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
