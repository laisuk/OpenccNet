<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net9.0</TargetFrameworks>

        <!-- Package Information for NuGet -->
        <PackageId>OpenccNetLib</PackageId>
        <Version>1.6.2</Version>
        <Authors>laisuk</Authors>
        <Description>
            OpenCC .NET library for Chinese text conversion between Traditional and Simplified Chinese.
            Supports high-performance dictionary-based segment replacement with support for both CLI and GUI tools.
        </Description>
        <PackageTags>opencc;chinese;conversion;traditional;simplified</PackageTags>
        <RepositoryUrl>https://github.com/laisuk/OpenccNet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/laisuk/OpenccNet</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!-- Generate the XML doc file alongside the DLL -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- (Optional) don’t warn about undocumented public members -->
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Title>OpenccNet Library</Title>
        <PackageReleaseNotes>OpenccNetLib v1.6.2

            - Added a net9.0 target asset for modern runtime optimizations while retaining netstandard2.0 as the primary compatibility target and fallback.
            - Optimized conversion, compatibility normalization, text splitting, IDS preservation, and DeTofu on .NET 9+ to reduce allocations and improve throughput while preserving the established netstandard2.0 paths.
            - Added Opencc.NormalizeUnicodeCompat() for curated scalar-preserving CJK Unicode compatibility, punctuation, and text-extraction normalization.
            - Extended Opencc.NormalizeCompat() with optional extended Unicode compatibility normalization while preserving its default behavior.
            - Added canonical custom-dictionary token parsing with strict DictSlot validation and portable &lt;slot&gt;:&lt;append|override&gt;:&lt;path&gt; syntax.
            - Added an optional punctuation argument to direct Traditional → Traditional regional conversion APIs.
            - Improved DeTofu with Unicode scalar lookup, cached built-in mapping data, and independently mutable built-in maps.
            - Updated conversion dictionaries and curated Unicode compatibility mappings.
            - Expanded differential, randomized, Unicode, IDS, DeTofu, and malformed-input test coverage.
            - Refactored Office/EPUB package processing into two entry-by-entry paths: pure in-memory ConvertOfficeBytes() APIs and separate streaming ConvertOfficeFile() APIs with validated temporary-file publication, while preserving EPUB packaging requirements.

            Breaking: custom dictionary bundles must include jps_characters_rev; regenerate custom JSON/CBOR/Zstd bundles for v1.6.x.
        </PackageReleaseNotes>
        <AssemblyVersion>1.6.2.0</AssemblyVersion>
        <FileVersion>1.6.2.0</FileVersion>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PeterO.Cbor" Version="4.5.5"/>
        <PackageReference Include="System.Memory" Version="4.6.3"/>
        <PackageReference Include="System.Text.Json" Version="8.0.6" />
        <PackageReference Include="ZstdSharp.Port" Version="0.8.8"/>
    </ItemGroup>

    <!-- Include icon file in package -->
    <ItemGroup>
        <None Include="Images/icon.png" Pack="true" PackagePath="/"/>
        <None Update="dicts\Unicode_Compatibility.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <!-- Include README in package -->
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <!-- Dictionary files - included in package and copied to output -->
    <ItemGroup>
        <!-- Include all files under dicts (with extensions) -->
        <None Include="dicts\**\*.*">
            <Pack>true</Pack>
            <PackagePath>contentFiles\any\any\dicts\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="data\**\*.*">
            <Pack>false</Pack>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
